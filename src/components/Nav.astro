---
import { whatsappLinkAttrs, type WhatsAppOrigin } from '../lib/whatsapp';

export interface Props {
  /** Em landing pages de tráfego pago, esconde os links internos para não vazar o clique pago. */
  minimal?: boolean;
  origin?: WhatsAppOrigin;
  /**
   * Remove o atalho para o WhatsApp. Existe para a página do funil: lá o
   * WhatsApp é o final de um caminho que filtra casal, criança e presencial,
   * e um atalho no topo devolveria à agenda exatamente o lead que o funil
   * existe para descartar.
   */
  hideWhatsApp?: boolean;
  /** Destino do botão principal. Em `minimal`, o padrão aponta para a seção de agendamento. */
  ctaHref?: string;
  ctaLabel?: string;
  /**
   * Transforma o nome em link. Em página sem rodapé e sem menu no celular, é a
   * única saída visível para o resto do site — e o nome é onde a pessoa tenta
   * clicar por hábito.
   */
  logoHref?: string;
}

const {
  minimal = false,
  origin = 'nav',
  hideWhatsApp = false,
  ctaHref = minimal ? '#agendar' : '/#agendar',
  ctaLabel = 'Agendar sessão',
  logoHref,
} = Astro.props;
---

<!-- NAV -->
<nav id="mainNav">
  {logoHref
    ? <a class="logo logo-link" href={logoHref}>Juliana <span>Capucci</span></a>
    : <div class="logo">Juliana <span>Capucci</span></div>}
  {!minimal && (
    <button class="hamburger" id="menuToggle" aria-label="Abrir menu de navegação">
      <span></span>
      <span></span>
      <span></span>
    </button>
  )}
  <div class="nav-links" id="navLinks">
    {!minimal && (
      <>
        <a href="/#sobre">Sobre Mim</a>
        <a href="/#abordagem">Minha Abordagem</a>
        <a href="/#informacoes">Informações Importantes</a>
        <a href="/blog/">Blog</a>
      </>
    )}
    {!hideWhatsApp && (
      <a {...whatsappLinkAttrs({ origin })} class="btn-ghost">Fale no WhatsApp</a>
    )}
    <a href={ctaHref} class="nav-cta">{ctaLabel}</a>
  </div>
</nav>
