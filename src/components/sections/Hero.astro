---
import { whatsappLinkAttrs, type WhatsAppOrigin } from '../../lib/whatsapp';

export interface Props {
  origin?: WhatsAppOrigin;
  ariaLabel?: string;
  title?: string;
  subtitle?: string;
  ctaLabel?: string;
}

const {
  origin = 'home-hero',
  ariaLabel = 'Juliana Capucci — Psicóloga Online para Ansiedade, Família, Maternidade, Relacionamentos e Intercâmbio (Au Pair e Estudos)',
  title = 'Uma psicóloga tão<br>humana quanto<br><em>você!</em>',
  subtitle = 'Atendimentos psicológicos online, realizados com segurança, ética e acolhimento para adolescentes e adultos.',
  ctaLabel = 'Agendar minha sessão',
} = Astro.props;
---

<!-- HERO -->
<section class="hero" id="home" aria-label={ariaLabel}>
  <div class="hero-blob-1"></div>
  <div class="hero-blob-2"></div>

  <div class="hero-text">
    <p class="hero-eyebrow">Psicoterapia Online · CRP 06/209216</p>
    <div class="hero-line" aria-hidden="true"></div>
    <h1 class="hero-title" set:html={title}></h1>
    <p class="hero-subtitle">{subtitle}</p>
    <div class="hero-actions">
      <a {...whatsappLinkAttrs({ origin })} class="btn-primary">{ctaLabel}</a>
      <a href="#sobre" class="btn-ghost">Saber mais</a>
    </div>
  </div>

  <div class="hero-visual">
    <div class="hero-img-wrap">
      <img src="/img/profile.jpg" alt="Juliana Capucci, psicóloga clínica online especializada em ansiedade, dinâmicas familiares, apoio emocional à maternidade, relacionamentos, saúde mental no intercâmbio (au pairs e estudantes) e Terapia Cognitivo-Comportamental (TCC)" width="380" height="480" loading="eager" fetchpriority="high" decoding="async">
    </div>
    <div class="hero-badge">
      <strong>+5000</strong>
      Horas de prática
    </div>
  </div>
</section>
