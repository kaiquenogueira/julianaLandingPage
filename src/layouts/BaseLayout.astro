---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const {
  title = 'Juliana Capucci | Psicóloga Online para Ansiedade e Família · TCC',
  description = 'Juliana Capucci (CRP 06/209216) é Psicóloga Clínica especializada em TCC. Psicoterapia online para ansiedade, dinâmicas familiares e saúde mental de au pairs. Agende sua sessão →',
  image = '/img/profile.jpg',
  canonical,
} = Astro.props;

const canonicalUrl = canonical || Astro.url.href;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || '';
const absoluteImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
---

<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-974807273"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'AW-974807273');

    // Event snippet for contato para o whtasapp conversion page
    function gtag_report_conversion(url) {
      var callback = function () {
        if (typeof(url) != 'undefined') {
          window.location = url;
        }
      };
      gtag('event', 'conversion', {
          'send_to': 'AW-974807273/_5kACLbX4oEcEOnB6dAD',
          'event_callback': callback
      });
      return false;
    }

    // Attach click listener globally to all links pointing to WhatsApp
    document.addEventListener('click', function(e) {
      var link = e.target.closest('a');
      if (link && link.href && (link.href.includes('wa.me') || link.href.includes('api.whatsapp.com'))) {
        e.preventDefault();
        gtag_report_conversion(link.href);
      }
    });
  </script>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>

  <!-- Agentic e Tradicional SEO -->
  <meta name="description" content={description}>
  <!-- Keywords em formato NLU/Intent para IA contextualizar o conteúdo como respostas à pesquisas -->
  <meta name="keywords" content="Juliana Capucci, psicóloga online, psicoterapia online, ansiedade, família, au pair saúde mental, Terapia Cognitivo-Comportamental TCC, psicóloga para adolescentes e adultos, CRP 06/209216">
  <meta name="author" content="Juliana Capucci">
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
  <link rel="canonical" href={canonicalUrl}>
  <link rel="me" href="https://instagram.com/psijulianacapucci">
  <link rel="author" href={`${siteUrl}/`}>

  <!-- Open Graph -->
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:image" content={absoluteImage}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:locale" content="pt_BR">
  <meta property="og:site_name" content="Juliana Capucci — Psicoterapia Online">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={absoluteImage}>

  <!-- Theme -->
  <meta name="theme-color" content="#C4908A">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <!-- Fonts (preload) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap"
    rel="stylesheet">



