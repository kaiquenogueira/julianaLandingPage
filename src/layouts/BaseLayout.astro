---
import '../styles/global.css';
import ConsentBanner from '../components/ConsentBanner.astro';

// IDs de mídia. GA4 e Meta Pixel só entram quando as variáveis estiverem
// definidas na Vercel — sem placeholder falso no HTML.
//
// Contas do Google Ads que recebem a tag base. Mais de uma conta convive sem
// conflito: cada uma monta o próprio público de remarketing. O primeiro ID é o
// que carrega o gtag.js; os demais entram só como `config`.
const GOOGLE_ADS_IDS = [
  'AW-974807273',    // conta antiga
  'AW-18373032857',  // conta nova
];

// Ações de conversão disparadas no clique de WhatsApp. Cada conta precisa da
// própria ação criada na interface do Google Ads — o rótulo depois da barra é
// exclusivo dela e não pode ser reaproveitado entre contas.
const GOOGLE_ADS_CONVERSIONS = [
  'AW-974807273/_5kACLbX4oEcEOnB6dAD',
];

const GA4_ID = import.meta.env.PUBLIC_GA4_ID;
const META_PIXEL_ID = import.meta.env.PUBLIC_META_PIXEL_ID;

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const {
  title = 'Juliana Capucci | Psicóloga Online · Ansiedade, Maternidade e Intercâmbio',
  description = 'Juliana Capucci (CRP 06/209216), Psicóloga Clínica. Psicoterapia online com TCC para ansiedade, maternidade, relacionamentos e intercâmbio (au pair e estudos). Agende →',
  image = '/img/profile.jpg',
  canonical,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || '';
const baseUrl = siteUrl || Astro.url.origin;
const canonicalCandidate = canonical ? new URL(canonical, baseUrl) : new URL(Astro.url);
const canonicalNormalized = new URL(canonicalCandidate.toString());
canonicalNormalized.hash = '';
canonicalNormalized.search = '';
const canonicalLastSegment = canonicalNormalized.pathname.split('/').pop() ?? '';
if (!canonicalNormalized.pathname.endsWith('/') && !canonicalLastSegment.includes('.')) {
  canonicalNormalized.pathname = `${canonicalNormalized.pathname}/`;
}
const canonicalUrl = canonicalNormalized.toString();
const absoluteImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
---

<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <!-- Decisão de consentimento já tomada em visita anterior. Lida antes de tudo
       para que o gtag aplique o estado certo já dentro do worker do Partytown,
       sem corrida entre a thread principal e o worker. -->
  <script is:inline>
    try { window.__jcConsent = localStorage.getItem('jc-consent'); } catch (e) { window.__jcConsent = null; }
  </script>

  <!-- Google tag (gtag.js) — Google Ads + GA4 -->
  <script type="text/partytown" async src={`https://www.googletagmanager.com/gtag/js?id=${GOOGLE_ADS_IDS[0]}`}></script>
  <script type="text/partytown" set:html={`
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    // Atribuição explícita: dentro do worker do Partytown a declaração de função
    // não chega ao objeto global, e o forward da thread principal quebra ao
    // aplicar window.gtag — o que derrubava silenciosamente toda conversão.
    window.gtag = gtag;

    // Consent Mode v2 — LGPD: nada de marketing antes do aceite explícito.
    gtag('consent', 'default', {
      'ad_storage': 'denied',
      'ad_user_data': 'denied',
      'ad_personalization': 'denied',
      'analytics_storage': 'denied',
      'wait_for_update': 500
    });

    if (window.__jcConsent === 'granted') {
      gtag('consent', 'update', {
        'ad_storage': 'granted',
        'ad_user_data': 'granted',
        'ad_personalization': 'granted',
        'analytics_storage': 'granted'
      });
    }

    gtag('js', new Date());
    ${GOOGLE_ADS_IDS.map((id) => `gtag('config', '${id}');`).join('\n    ')}
    ${GA4_ID ? `gtag('config', '${GA4_ID}');` : ''}
  `} />

  {META_PIXEL_ID && (
    <script type="text/partytown" set:html={`
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window,document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('consent', 'revoke');
      fbq('init', '${META_PIXEL_ID}');
      fbq('track', 'PageView');
    `} />
  )}

  <script is:inline set:html={`
    (function () {
      var ADS_CONVERSIONS = ${JSON.stringify(GOOGLE_ADS_CONVERSIONS)};
      var DEFAULT_MESSAGE_PREFIX = 'Oi, Juliana! Vim pelo site (';
      var DEFAULT_MESSAGE_SUFFIX = ') e gostaria de agendar uma sessão.';

      function isWhatsApp(href) {
        return href.indexOf('wa.me') !== -1 || href.indexOf('api.whatsapp.com') !== -1;
      }

      function pageLabel() {
        var title = (document.title || '').split('—')[0].trim();
        return title || document.location.pathname;
      }

      // Links escritos em markdown não passam pelo helper de build. Preenche a
      // mensagem com o título da página para não perder a origem do lead.
      function ensureOrigin(link) {
        var url;
        try { url = new URL(link.href); } catch (e) { return; }
        if (url.searchParams.get('text')) return;
        url.searchParams.set('text', DEFAULT_MESSAGE_PREFIX + pageLabel() + DEFAULT_MESSAGE_SUFFIX);
        link.href = url.toString();
      }

      function enhanceAll() {
        var links = document.querySelectorAll('a[href]');
        for (var i = 0; i < links.length; i++) {
          if (isWhatsApp(links[i].href)) {
            ensureOrigin(links[i]);
            if (!links[i].target) {
              links[i].target = '_blank';
              links[i].rel = 'noopener noreferrer';
            }
          }
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', enhanceAll);
      } else {
        enhanceAll();
      }

      document.addEventListener('click', function (e) {
        var link = e.target && e.target.closest ? e.target.closest('a[href]') : null;
        if (!link || !isWhatsApp(link.href)) return;

        ensureOrigin(link);
        var origin = link.getAttribute('data-wa-origin') || document.location.pathname;

        // Sem preventDefault de propósito: o link abre em nova aba, a página de
        // origem continua viva e o beacon termina de sair. Se o gtag estiver
        // bloqueado ou o Partytown falhar, o lead chega no WhatsApp mesmo assim.
        if (typeof window.gtag === 'function') {
          for (var i = 0; i < ADS_CONVERSIONS.length; i++) {
            window.gtag('event', 'conversion', { 'send_to': ADS_CONVERSIONS[i], 'wa_origin': origin });
          }
          window.gtag('event', 'contato_whatsapp', { 'wa_origin': origin });
        }
        if (typeof window.fbq === 'function') {
          window.fbq('track', 'Contact', { 'wa_origin': origin });
        }
      });
    })();
  `} />

