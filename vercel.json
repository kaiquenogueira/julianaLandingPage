{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "cleanUrls": false,
    "trailingSlash": true,
    "redirects": [
        {
            "source": "/:path(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "julianacapucci.com.br"
                }
            ],
            "destination": "https://www.julianacapucci.com.br/:path",
            "permanent": true
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                }
            ]
        }
    ]
}